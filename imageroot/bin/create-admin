#!/usr/bin/env python3

#
# Copyright (C) 2026 Nethesis S.r.l.
# SPDX-License-Identifier: GPL-3.0-or-later
#

#
# Create the first calrs administrator: create-admin <email> <name>, password on stdin.
# Exit 0 when the account is created, 3 when one already exists, 2 on failure.
#
# create-admin --check only reports, with the same exit codes: 3 when calrs
# already holds an account, 0 when the base is empty.
#
# `calrs user create` has no --password flag and reads it with rpassword, hence the PTY.
#

import os
import pty
import subprocess
import sys

import agent

check_only = sys.argv[1:2] == ["--check"]

if check_only:
    email = name = password = ""
else:
    email = sys.argv[1]
    name = sys.argv[2]
    password = sys.stdin.readline().rstrip("\n")

sys.stdout = sys.stderr

def cli(*args, tty=False):
    """Command line of an ephemeral calrs container"""
    return [
        "podman", "run", "--rm", "--network=none",
        "--volume", "calrs-data:/var/lib/calrs:z",
    ] + (["-i", "-t"] if tty else []) + [os.environ["CALRS_IMAGE"]] + list(args)


def run_with_password(args, secret):
    """Run a command attached to a PTY and answer its password prompt"""
    master, slave = pty.openpty()
    proc = subprocess.Popen(args, stdin=slave, stdout=slave, stderr=slave, close_fds=True)
    os.close(slave)
    os.write(master, (secret + "\n").encode())
    output = b""
    while True:
        try:
            chunk = os.read(master, 1024)
        except OSError:
            break
        if not chunk:
            break
        output += chunk
    os.close(master)
    return proc.wait(), output.decode(errors="replace")


users = subprocess.run(cli("user", "list"), capture_output=True, text=True)
if users.returncode != 0:
    print(agent.SD_ERR + "Cannot list calrs users: " + users.stderr, file=sys.stderr)
    sys.exit(2)

# An email in the table means an account exists: leave an existing install alone.
# Exit 3 so the caller knows no account was created and records nothing.
if "@" in users.stdout:
    if not check_only:
        print("A calrs account already exists: administrator creation skipped", file=sys.stderr)
    sys.exit(3)

if check_only:
    sys.exit(0)

# Upstream promotes the first registered account to admin: close that door
# before opening one, so a failed run leaves nothing to claim and the next run
# closes it again. Once an account exists the branch above wins and the calrs
# admin panel owns the setting.
registration = subprocess.run(
    cli("config", "auth", "--registration", "false"),
    capture_output=True, text=True,
)
if registration.returncode != 0:
    print(agent.SD_ERR + "Cannot disable registration: " + registration.stderr, file=sys.stderr)
    sys.exit(2)
print("Open registration disabled", file=sys.stderr)

rc, output = run_with_password(
    cli("user", "create", "--email", email, "--name", name, "--admin", tty=True),
    password,
)
if rc != 0:
    print(agent.SD_ERR + "Administrator creation failed: " + output, file=sys.stderr)
    sys.exit(2)
print(f"Administrator {email} created", file=sys.stderr)
