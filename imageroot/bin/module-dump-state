#

set -e

exec 1>&2

if ! podman volume exists calrs-data; then
    exit 0
fi

mountpoint=$(podman volume inspect calrs-data --format '{{.Mountpoint}}')

# Without unshare the volume files are not readable: they belong to a sub-uid
podman unshare python3 "${AGENT_INSTALL_DIR}/bin/sqlite-backup.py" \
    "${mountpoint}/calrs.db" "${AGENT_STATE_DIR}/calrs-backup.db"
