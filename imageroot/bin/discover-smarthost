#
# Generate state/discovery.env, the environment block injected in the calrs
# container. Rewritten at every container start and on smarthost-changed.
#

import os
import sys
import agent

envfile = "discovery.env"
tmpfile = envfile + "." + str(os.getpid()) + ".tmp"
lines = []

# Read the replica: the module must start even when the leader is unreachable
rdb = agent.redis_connect(use_replica=True)
smtp = agent.get_smarthost_settings(rdb)

# Without both HOST and FROM_EMAIL calrs ignores the block and warns
if smtp['enabled'] and smtp['host']:
    from_email = os.environ.get('CALRS_MAIL_FROM', '')
    if not from_email:
        from_email = 'noreply@' + os.environ.get('TRAEFIK_HOST', 'localhost')
    lines.append(f"CALRS_SMTP_HOST={smtp['host']}")
    lines.append(f"CALRS_SMTP_PORT={smtp['port']}")
    lines.append(f"CALRS_SMTP_TLS_MODE={smtp['encrypt_smtp']}")
    lines.append(f"CALRS_SMTP_FROM_EMAIL={from_email}")
    lines.append("CALRS_SMTP_FROM_NAME=calrs")
    # A password without a username is a fatal error for calrs
    if smtp['username']:
        lines.append(f"CALRS_SMTP_USERNAME={smtp['username']}")
        lines.append(f"CALRS_SMTP_PASSWORD={smtp['password']}")
    if not smtp['tls_verify']:
        print(agent.SD_WARNING + "The smarthost disables TLS verification: calrs always verifies it", file=sys.stderr)
else:
    print("Smarthost is not configured: SMTP settings are left to the calrs admin page", file=sys.stderr)

# An empty value would force an empty allow list and override the database
private_hosts = os.environ.get('CALRS_ALLOW_PRIVATE_HOSTS', '')
if private_hosts:
    lines.append(f"CALRS_ALLOW_PRIVATE_HOSTS={private_hosts}")

with open(tmpfile, 'w') as efp:
    for line in lines:
        print(line, file=efp)

os.chmod(tmpfile, 0o600)
os.replace(tmpfile, envfile)
