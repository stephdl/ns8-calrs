#
# This systemd unit starts the calrs pod using Podman.
# Most parts of this file come from podman-generate-systemd.
#

[Unit]
Description=Podman calrs.service
Requires=calrs-app.service
Before=calrs-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=-%S/state/environment
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/calrs.pid %t/calrs.pod-id
ExecStartPre=/usr/bin/podman pod create --infra-conmon-pidfile %t/calrs.pid \
    --pod-id-file %t/calrs.pod-id \
    --name calrs \
    --publish 127.0.0.1:${TCP_PORT}:3000 \
    --replace \
    --network=slirp4netns:allow_host_loopback=true
ExecStart=/usr/bin/podman pod start --pod-id-file %t/calrs.pod-id
ExecStop=/usr/bin/podman pod stop --ignore --pod-id-file %t/calrs.pod-id -t 10
ExecStopPost=/usr/bin/podman pod rm --ignore -f --pod-id-file %t/calrs.pod-id
PIDFile=%t/calrs.pid
Type=forking

[Install]
WantedBy=default.target
