[Unit]
Description=Podman calrs-app.service
BindsTo=calrs.service
After=calrs.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
WorkingDirectory=%S/state
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/calrs-app.pid %t/calrs-app.ctr-id
# podman run --env-file fails if the file is missing: create it before the discovery script
ExecStartPre=/bin/touch discovery.env
ExecStartPre=-runagent discover-smarthost
ExecStart=/usr/bin/podman run --conmon-pidfile %t/calrs-app.pid \
    --cidfile %t/calrs-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/calrs.pod-id --replace -d --name calrs-app \
    --volume calrs-data:/var/lib/calrs:z \
    --env=CALRS_BASE_URL=https://${TRAEFIK_HOST} \
    --env=RUST_LOG=calrs=info \
    --env-file=%S/state/discovery.env \
    ${CALRS_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/calrs-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/calrs-app.ctr-id
SyslogIdentifier=%u
PIDFile=%t/calrs-app.pid
Type=forking

[Install]
WantedBy=default.target
