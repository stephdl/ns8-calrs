#
# Restic restores both the volume and the snapshot taken by module-dump-state.
# Only the snapshot is guaranteed consistent, so it replaces the database file.
# The copy runs in a container built on the application image, to give the file
# back to the calrs user.
#

set -e -o pipefail
exec 1>&2 # Redirect any output to the journal (stderr)

if [ ! -f "${AGENT_STATE_DIR}/calrs-backup.db" ]; then
    echo "No database snapshot found in the backup: nothing to restore"
    exit 0
fi

podman run \
  --rm \
  --network=none \
  --user root \
  --entrypoint=/bin/bash \
  --volume calrs-data:/var/lib/calrs:z \
  --volume "${AGENT_STATE_DIR}":/srv:z \
  --replace --name=restore_db \
  ${CALRS_IMAGE} \
  -c 'rm -f /var/lib/calrs/calrs.db-wal /var/lib/calrs/calrs.db-shm &&
      cp /srv/calrs-backup.db /var/lib/calrs/calrs.db &&
      chown calrs:calrs /var/lib/calrs/calrs.db'

rm -f "${AGENT_STATE_DIR}/calrs-backup.db"
