#
# Create the administrator before the service starts: the calrs CLI migrates
# a cold volume on its own.
#

import json
import subprocess
import sys

import agent

data = json.load(sys.stdin)

email = data.get("admin_email", "")
password = data.get("admin_password", "")

if not email or not password:
    print("No administrator credentials provided: step skipped", file=sys.stderr)
    sys.exit(0)

name = data.get("admin_name", "") or email

proc = subprocess.run(
    ["create-admin", email, name],
    input=password + "\n",
    text=True,
)

# 3 means an account was already there: nothing was created, record nothing
if proc.returncode == 3:
    sys.exit(0)

agent.assert_exp(proc.returncode == 0, "The create-admin helper failed!")

# Written here and not with the other variables: the UI reads it to tell that
# the account exists, so an attempt that created nothing must not set it
agent.set_env("CALRS_ADMIN_EMAIL", email)
