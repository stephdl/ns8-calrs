import json
import sys
import agent

data = json.load(sys.stdin)

agent.set_env("TRAEFIK_HOST", data["host"])
agent.set_env("TRAEFIK_HTTP2HTTPS", data.get("http2https", True))
agent.set_env("CALRS_MAIL_FROM", data.get("mail_from", ""))
agent.set_env("CALRS_ALLOW_PRIVATE_HOSTS", ",".join(data.get("allow_private_hosts", [])))

# The administrator password is never stored: set_env writes to Redis in clear text
agent.set_env("CALRS_ADMIN_EMAIL", data.get("admin_email", ""))

# Make sure everything is saved inside the environment file, the next steps
# read it back
agent.dump_env()
