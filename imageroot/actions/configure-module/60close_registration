#
# calrs ships with open registration and promotes the first account that
# registers to administrator. Close that door before the service starts,
# whatever the administrator step does next.
#

set -e -o pipefail
exec 1>&2

podman run \
  --rm \
  --network=none \
  --volume calrs-data:/var/lib/calrs:z \
  --replace --name=close_registration \
  ${CALRS_IMAGE} \
  config auth --registration false

echo "Open registration disabled"
