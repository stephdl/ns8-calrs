#
# Read configuration
#

import os
import sys
import json
import agent

# Prepare return variable
config = {}

# Read current configuration from the environment file
config["host"] = os.getenv("TRAEFIK_HOST", "")
config["http2https"] = os.getenv("TRAEFIK_HTTP2HTTPS") == "True"
config["lets_encrypt"] = agent.get_route(os.environ['MODULE_ID']).get('lets_encrypt', False)
config["mail_from"] = os.getenv("CALRS_MAIL_FROM", "")
private_hosts = os.getenv("CALRS_ALLOW_PRIVATE_HOSTS", "")
config["allow_private_hosts"] = private_hosts.split(",") if private_hosts else []
# An empty value tells the UI the administrator account is still to be created
config["admin_email"] = os.getenv("CALRS_ADMIN_EMAIL", "")

# Dump the configuration to stdout
json.dump(config, fp=sys.stdout)
